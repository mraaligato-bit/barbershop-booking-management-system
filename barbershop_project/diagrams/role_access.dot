digraph RoleAccess {
  graph [rankdir=TB, bgcolor="#f6f5f0", pad="0.28", nodesep="0.35", ranksep="0.55", splines=ortho, fontname="Arial", label="ROLE-BASED ACCESS AND STAFF WORKFLOW", labelloc=t, fontsize=19, fontcolor="#183b2b"];
  node [fontname="Arial", fontsize=10, style="filled,rounded", color="#b9c9b8", fillcolor="#fffefa", fontcolor="#17251f", penwidth=1.2, margin="0.16,0.10"];
  edge [fontname="Arial", fontsize=9, color="#56735f", fontcolor="#355342", penwidth=1.2, arrowsize=0.75];
  start [label="START", shape=oval, fillcolor="#d4ee9d", color="#5d833f"];
  public [label="Homepage / public pages", shape=box];
  login [label="Customer login OR\nshared staff login", shape=box, fillcolor="#e8f0e4"];
  valid [label="Credentials valid?", shape=diamond, style=filled, fillcolor="#fff0c2", color="#b58b28", margin="0.08,0.04"];
  denied [label="Show error; retry or exit", shape=box, fillcolor="#fae8e5", color="#c66a61"];
  route [label="Read assigned role from account", shape=box, fillcolor="#e8f0e4"];
  role [label="Which role?", shape=diamond, style=filled, fillcolor="#fff0c2", color="#b58b28", margin="0.08,0.04"];
  customer [label="CUSTOMER DASHBOARD\nOwn profile and bookings\nBook / cancel by policy\nReview completed visits only", shape=box, fillcolor="#e5effc", color="#7a9fc8"];
  admin [label="ADMIN DASHBOARD\nDaily booking operations\nCustomer support and schedules\nModerate reviews / service ops", shape=box, fillcolor="#fff1d8", color="#d2a05b"];
  barber [label="BARBER DASHBOARD\nAssigned appointments only\nUpdate visit status\nOwn day / week / month earnings", shape=box, fillcolor="#e0f3e4", color="#76a682"];
  owner [label="OWNER DASHBOARD\nAll bookings and staff accounts\nRevenue, recorded expenses, payroll\nPay rules and business settings", shape=box, fillcolor="#e9e2f7", color="#9b83c8"];
  audit [label="Log out / end session", shape=box];
  end [label="END", shape=oval, fillcolor="#d4ee9d", color="#5d833f"];
  start -> public -> login -> valid;
  valid -> denied [label="NO"];
  denied -> login;
  valid -> route [label="YES"];
  route -> role;
  role -> customer [label="CUSTOMER"];
  role -> admin [label="ADMIN"];
  role -> barber [label="BARBER"];
  role -> owner [label="OWNER"];
  customer -> audit; admin -> audit; barber -> audit; owner -> audit; audit -> end;
  {rank=same; customer; admin; barber; owner}
}
