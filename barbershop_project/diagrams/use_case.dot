digraph UseCases {
 graph [rankdir=LR, bgcolor="#f6f5f0", pad="0.25", nodesep="0.28", ranksep="0.42", splines=true, fontname="Arial", label="USE-CASE OVERVIEW", labelloc=t, fontsize=19, fontcolor="#183b2b"];
 node [fontname="Arial", fontsize=9, color="#6e8c75", fontcolor="#17251f"];
 edge [fontname="Arial", fontsize=8, color="#7b8b7e", arrowsize=.6];
 customer [label="Customer", shape=box, style="rounded,filled", fillcolor="#e5effc"];
 admin [label="Admin", shape=box, style="rounded,filled", fillcolor="#fff1d8"];
 barber [label="Barber / Employee", shape=box, style="rounded,filled", fillcolor="#e0f3e4"];
 owner [label="Owner", shape=box, style="rounded,filled", fillcolor="#e9e2f7"];
 subgraph cluster_system { label="Barbershop Booking Management System"; color="#b9c9b8"; style="rounded"; penwidth=1.3;
  browse [label="Browse services, barbers\nand public reviews", shape=ellipse, style=filled, fillcolor="#fffefa"];
  book [label="Create / view / cancel\nown booking", shape=ellipse, style=filled, fillcolor="#fffefa"];
  review [label="Review completed service", shape=ellipse, style=filled, fillcolor="#fffefa"];
  ops [label="Manage bookings and\ndaily operations", shape=ellipse, style=filled, fillcolor="#fffefa"];
  moderate [label="Moderate reviews", shape=ellipse, style=filled, fillcolor="#fffefa"];
  schedule [label="View assigned schedule;\nupdate service status", shape=ellipse, style=filled, fillcolor="#fffefa"];
  earnings [label="View own earnings", shape=ellipse, style=filled, fillcolor="#fffefa"];
  financial [label="Review revenue, expenses,\npayroll and reports", shape=ellipse, style=filled, fillcolor="#fffefa"];
  settings [label="Manage staff, services,\nprices and pay rules", shape=ellipse, style=filled, fillcolor="#fffefa"];
 }
 customer -> browse; customer -> book; customer -> review;
 admin -> ops; admin -> moderate;
 barber -> schedule; barber -> earnings;
 owner -> ops; owner -> moderate; owner -> financial; owner -> settings;
}
